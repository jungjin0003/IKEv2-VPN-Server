#!/bin/sh
# ikev2watch - IKEv2 log watcher: structured connection event log (used by
# the management UI's "Log" page) + optional DSM Auto Block integration.
#
# Parses our own bundled charon's log (${VAR}/charon.log, written by the
# filelog plugin per the strongswan.conf ikev2ctl generates) for
# authentication successes/failures/disconnects, always recording a
# structured event log (${VAR}/events.log) regardless of the auto-block
# setting. When IKEV2_AUTOBLOCK=yes, also counts failures per source IP
# using DSM's own auto-block threshold settings (Control Panel > Security >
# Protection) and registers offenders in the DSM auto-block DB
# (/etc/synoautoblock.db). The package also mirrors active denied entries
# into its own INPUT chain so IKEv2 traffic is rejected before charon.
#
# usage: ikev2watch start|stop|run|status

PKG="IKEv2VPN"
PKG_DIR="/var/packages/${PKG}"
ETC="${PKG_DIR}/etc"
VAR="${PKG_DIR}/var"
LOG="${VAR}/ikev2.log"
CHARON_LOG="${VAR}/charon.log"
PIDFILE="${VAR}/ikev2watch.pid"
FAILDB="${VAR}/authfail.list"
OFFSET_FILE="${VAR}/logoffset/charon.log"
# id->peer-IP map, persisted ACROSS scan passes. charon only prints the
# client IP in "x.x.x.x[port]" form on the early packets (received packet /
# IKE_SA_INIT); the later "established"/"deleted" lines carry the IP only in
# "[identity]" form or not at all - so without remembering the IP per IKE_SA
# id between passes, connect/disconnect events would be dropped (which is
# exactly why the UI Log page only ever showed auth failures).
ADDR_STATE="${VAR}/logoffset/ikeaddr"
ADDR_MAX_LINES=500
EVENTS_LOG="${VAR}/events.log"
EVENTS_MAX_LINES=2000

AB_DB="/etc/synoautoblock.db"
BLOCK_CHAIN="IKEV2VPN_BLOCK"
INTERVAL=20

# package settings, read through the same loader ikev2ctl uses so the
# settings.d drop-ins apply here too (only ${ETC} has to be set beforehand)
. "$(dirname "$0")/lib/settings.sh"

# Update check and the DSM notification it raises. Both modules derive their
# own paths, so they do not need common.sh - which ikev2ctl loads and this
# does not.
. "$(dirname "$0")/lib/notify.sh"
. "$(dirname "$0")/lib/release.sh"

IKEV2_AUTOBLOCK="no"
read_pkg_settings() {
    load_settings
}

log() {
    mkdir -p "$VAR"
    echo "$(date '+%Y-%m-%d %H:%M:%S') [watch] $*" >> "$LOG"
}

find_sqlite() {
    for b in /bin/sqlite3 /usr/bin/sqlite3 /usr/syno/bin/sqlite3; do
        [ -x "$b" ] && { echo "$b"; return 0; }
    done
    command -v sqlite3 2>/dev/null
}

# ------------------------------------------------- DSM auto-block settings

# defaults mirror DSM's own defaults
AB_ENABLE="unknown"
AB_ATTEMPTS=10
AB_WITHIN_SEC=300
AB_EXPIRE_DAY=0

read_ab_settings() {
    WEBAPI="/usr/syno/bin/synowebapi"
    [ -x "$WEBAPI" ] || return 0
    J=$("$WEBAPI" --exec api=SYNO.Core.Security.AutoBlock method=get version=1 2>/dev/null)
    [ -n "$J" ] || return 0
    case "$J" in
        *'"enable"'*true*|*'"enable":true'*) AB_ENABLE="yes" ;;
        *'"enable"'*false*) AB_ENABLE="no" ;;
    esac
    A=$(printf '%s' "$J" | sed -n 's/.*"attempts"[^0-9]*\([0-9]\+\).*/\1/p')
    W=$(printf '%s' "$J" | sed -n 's/.*"within_mins"[^0-9]*\([0-9]\+\).*/\1/p')
    E=$(printf '%s' "$J" | sed -n 's/.*"expire_day"[^0-9]*\([0-9]\+\).*/\1/p')
    [ -n "$A" ] && AB_ATTEMPTS="$A"
    [ -n "$W" ] && AB_WITHIN_SEC=$((W * 60))
    [ -n "$E" ] && AB_EXPIRE_DAY="$E"
}

# ------------------------------------------------------------ block DB ops

ipstd() {
    # 1.2.3.4 -> 0000:0000:0000:0000:0000:FFFF:0102:0304
    printf '%s' "$1" | awk -F. \
        '{printf "0000:0000:0000:0000:0000:FFFF:%02X%02X:%02X%02X", $1, $2, $3, $4}'
}

valid_ipv4() {
    printf '%s' "$1" | awk -F. '
        BEGIN { ok = 1 }
        NF != 4 { ok = 0 }
        {
            for (i = 1; i <= 4; i++) {
                if ($i !~ /^[0-9]+$/ || $i > 255) ok = 0
            }
        }
        END { exit (ok == 1 ? 0 : 1) }
    '
}
# DSM keeps the addresses an administrator allowed in the same table as the
# ones it blocked, told apart by the Deny column: what Control Panel >
# Security > Protection shows as the allow list is the Deny=0 rows. There is
# no separate table for them, and since the address is the primary key, a
# block written over one of those rows is what would take it off that list.
is_allowed() {
    valid_ipv4 "$1" || return 1
    SQLITE=$(find_sqlite); [ -n "$SQLITE" ] || return 1
    [ -f "$AB_DB" ] || return 1
    N=$("$SQLITE" "$AB_DB" "SELECT COUNT(*) FROM AutoBlockIP WHERE Deny=0 AND IP='$1';" 2>/dev/null)
    [ "$N" -gt 0 ] 2>/dev/null
}

db_block() {
    IP="$1"
    valid_ipv4 "$IP" || return 1
    is_allowed "$IP" && return 1
    SQLITE=$(find_sqlite)
    [ -n "$SQLITE" ] && [ -f "$AB_DB" ] || return 1
    NOW=$(date +%s)
    if [ "$AB_EXPIRE_DAY" -gt 0 ] 2>/dev/null; then
        EXP=$((NOW + AB_EXPIRE_DAY * 86400))
    else
        EXP=0
    fi
    STD=$(ipstd "$IP")
    # only use columns that exist in this DSM version's schema
    COLS=$("$SQLITE" "$AB_DB" "PRAGMA table_info(AutoBlockIP);" 2>/dev/null | cut -d'|' -f2)
    C="IP,RecordTime,ExpireTime,Deny"
    V="'$IP',$NOW,$EXP,1"
    if printf '%s\n' "$COLS" | grep -qx "IPStd"; then
        C="$C,IPStd"; V="$V,'$STD'"
    fi
    if printf '%s\n' "$COLS" | grep -qx "Type"; then
        C="$C,Type"; V="$V,0"
    fi
    if printf '%s\n' "$COLS" | grep -qx "Meta"; then
        C="$C,Meta"; V="$V,''"
    fi
    "$SQLITE" "$AB_DB" "INSERT OR REPLACE INTO AutoBlockIP ($C) VALUES ($V);" 2>/dev/null
}

# Succeeds when the database could be read, whatever it held. The rows are
# taken first and filtered after, so the exit status is the query's and not
# the last address's - the caller acts on the difference, and an address it
# cannot use (an IPv6 entry, say) is not the same as a database it could not
# reach.
denied_ips() {
    SQLITE=$(find_sqlite)
    [ -n "$SQLITE" ] && [ -f "$AB_DB" ] || return 1
    NOW=$(date +%s)
    ROWS=$("$SQLITE" "$AB_DB" \
        "SELECT IP FROM AutoBlockIP WHERE Deny=1 AND (ExpireTime=0 OR ExpireTime>$NOW);" \
        2>/dev/null) || return 1
    printf '%s\n' "$ROWS" | while IFS= read -r IP; do
        valid_ipv4 "$IP" && printf '%s\n' "$IP"
    done
    return 0
}

# --------------------------------------------------------- VPN-side blocking
#
# DSM's auto-block database protects DSM services, but it does not necessarily
# stop packets before they reach this package's charon listener. Keep a small,
# package-owned INPUT chain in sync with the same database so denied addresses
# are rejected on UDP 500/4500 and native ESP (protocol 50) as well.

iptables_bin() {
    command -v iptables 2>/dev/null
}

# Two chains, one of them live at a time. A change is built in whichever is
# idle and the jump is then moved onto it, so the addresses already denied
# stay denied throughout - flushing the live chain and refilling it would
# leave a gap on every pass.
block_chains() {
    printf '%s\n%s\n' "$BLOCK_CHAIN" "${BLOCK_CHAIN}2"
}

# The chain INPUT currently jumps to, if any.
block_live() {
    IPT=$(iptables_bin); [ -n "$IPT" ] || return 1
    for C in $(block_chains); do
        "$IPT" -C INPUT -j "$C" 2>/dev/null && { printf '%s\n' "$C"; return 0; }
    done
    return 1
}

# The addresses a chain denies, one per line, sorted - comparable with the
# set that is wanted.
block_contents() {
    IPT=$(iptables_bin); [ -n "$IPT" ] || return 1
    "$IPT" -S "$1" 2>/dev/null |
        sed -n 's/^-A [^ ]* -s \([0-9.]*\)\(\/32\)\{0,1\} .*/\1/p' | sort -u
}

block_remove() {
    [ "$(id -u)" = "0" ] || return 0
    IPT=$(iptables_bin); [ -n "$IPT" ] || return 0

    for C in $(block_chains); do
        while "$IPT" -C INPUT -j "$C" 2>/dev/null; do
            "$IPT" -D INPUT -j "$C" 2>/dev/null || break
        done
        "$IPT" -F "$C" 2>/dev/null
        "$IPT" -X "$C" 2>/dev/null
    done
}

# block_fill <chain> <addresses> - the chain is left holding exactly these.
block_fill() {
    CHAIN="$1"; shift
    IPT=$(iptables_bin); [ -n "$IPT" ] || return 1

    "$IPT" -N "$CHAIN" 2>/dev/null
    "$IPT" -F "$CHAIN" 2>/dev/null || return 1
    for IP in $@; do
        valid_ipv4 "$IP" || continue
        "$IPT" -A "$CHAIN" -s "$IP" -p udp --dport 500 -j DROP 2>/dev/null &&
        "$IPT" -A "$CHAIN" -s "$IP" -p udp --dport 4500 -j DROP 2>/dev/null &&
        "$IPT" -A "$CHAIN" -s "$IP" -p 50 -j DROP 2>/dev/null ||
            log "WARN: failed to add VPN block rule for $IP"
    done
}

# block_swap <chain> - INPUT jumps to this one and to no other of ours.
#
# The new jump goes in before the old one comes out, and it goes in at the
# top so a broader DSM rule cannot accept the packet first.
block_swap() {
    IPT=$(iptables_bin); [ -n "$IPT" ] || return 1

    "$IPT" -C INPUT -j "$1" 2>/dev/null ||
        "$IPT" -I INPUT 1 -j "$1" 2>/dev/null || return 1

    for C in $(block_chains); do
        [ "$C" = "$1" ] && continue
        while "$IPT" -C INPUT -j "$C" 2>/dev/null; do
            "$IPT" -D INPUT -j "$C" 2>/dev/null || break
        done
        "$IPT" -F "$C" 2>/dev/null
    done
}

sync_block_rules() {
    [ "$(id -u)" = "0" ] || return 0
    IPT=$(iptables_bin); [ -n "$IPT" ] || return 0

    # Turning the package option off removes only this package's chains. DSM's
    # own database and unrelated firewall rules are left untouched.
    if [ "$IKEV2_AUTOBLOCK" != "yes" ]; then
        block_remove
        return 0
    fi

    # Do not clear a working deny chain just because DSM's database is
    # temporarily unavailable or locked.
    IPS=$(denied_ips 2>/dev/null) || return 0

    WANT=$(printf '%s\n' $IPS | sed '/^$/d' | sort -u)
    LIVE=$(block_live)
    if [ -n "$LIVE" ] && [ "$WANT" = "$(block_contents "$LIVE")" ]; then
        return 0
    fi

    # Fill the one that is not carrying traffic, then move the jump to it.
    NEXT="$BLOCK_CHAIN"
    [ "$LIVE" = "$BLOCK_CHAIN" ] && NEXT="${BLOCK_CHAIN}2"
    block_fill "$NEXT" $WANT || return 0
    block_swap "$NEXT" || return 0

    log "VPN block chain updated ($(printf '%s\n' $WANT | sed '/^$/d' | wc -l | tr -d ' ') addresses)"
}

# ------------------------------------------------------------ log scanning
#
# Single pass over new lines appended to our own bundled charon's log
# (${CHARON_LOG}, filelog plugin, format fixed by the strongswan.conf
# ikev2ctl generates: "%Y-%m-%d %H:%M:%S <lvl>[<sub>] <connname|N> ...").
# On a recognized event, both (a) appends a structured
# "time|proto|user|event|ip" line to EVENTS_LOG for the UI's Log page and
# (b) echoes bare failure IPs to stdout for the auto-block counter.

scan_ike_log() {
    mkdir -p "$(dirname "$OFFSET_FILE")"
    [ -f "$CHARON_LOG" ] || return 0
    NOW_STR=$(date '+%Y-%m-%d %H:%M:%S')
    OLD=$(cat "$OFFSET_FILE" 2>/dev/null); [ -n "$OLD" ] || OLD=0
    SIZE=$(wc -c < "$CHARON_LOG" 2>/dev/null); [ -n "$SIZE" ] || SIZE=0
    # log rotated / truncated
    [ "$SIZE" -lt "$OLD" ] && OLD=0
    echo "$SIZE" > "$OFFSET_FILE"
    [ "$SIZE" -le "$OLD" ] && return 0

    ADDR_TMP="${ADDR_STATE}.tmp"
    tail -c +"$((OLD + 1))" "$CHARON_LOG" 2>/dev/null | awk -v now="$NOW_STR" -v ev="$EVENTS_LOG" \
        -v astate="$ADDR_STATE" -v astateout="$ADDR_TMP" '
    function connname(cn) {
        if (cn == "ikev2") return "MSCHAPv2"
        if (cn == "ikev2-psk") return "PSK"
        if (cn == "ikev2-rsa") return "RSA"
        if (cn == "ikev2-eaptls") return "EAP-TLS"
        return cn
    }
    BEGIN {
        # restore the id->ip map and the ids already counted as a failure,
        # both learned in previous passes
        while ((getline line < astate) > 0) {
            n = split(line, a, "\t")
            if (n >= 2 && a[1] != "") addr[a[1]] = a[2]
            if (n >= 3 && a[3] == "1") failed[a[1]] = 1
        }
        close(astate)
    }
    {
        if (!match($0, /<[^|>]*\|[0-9]+>/)) next
        id = substr($0, RSTART, RLENGTH); gsub(/[<>]/, "", id)   # "conn|N"
        cn = id; sub(/\|.*/, "", cn)                             # "conn"

        # learn/refresh this IKE_SA id peer IP from whatever form is present:
        #  (a) "x.x.x.x[port]"      - on received-packet / IKE_SA_INIT lines
        if (match($0, /[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\[[0-9]+\]/)) {
            s = substr($0, RSTART, RLENGTH); sub(/\[.*/, "", s)
            if (s != "127.0.0.1") addr[id] = s
        }
        #  (b) "...x.x.x.x" (the remote side of "between LOCAL...REMOTE") -
        #      appears on IKE_SA established / deleting lines
        if (match($0, /\.\.\.[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/)) {
            s = substr($0, RSTART, RLENGTH); sub(/^\.\.\./, "", s)
            if (s != "127.0.0.1") addr[id] = s
        }

        ip = (id in addr) ? addr[id] : ""

        # A credential charon rejected. There is one such line per try the
        # client made: MSCHAPv2 lets it retry inside a single IKE_SA and
        # every retry is written out on its own, so each line counts.
        fail = 0
        if ($0 ~ /verification failed|no shared key found/) {
            fail = 1
        }
        # How the authentication ended. This follows the line above whenever
        # there was one, and a pubkey or EAP-TLS client is reported only in
        # this form, so it counts only for an IKE_SA that has nothing counted
        # against it yet. "(myself)" is the local key or certificate
        # failing and says nothing about who connected.
        else if (!(id in failed) && $0 !~ /\(myself\)/ &&
                 $0 ~ /EAP method .* failed for peer|no trusted .* public key found|signature validation failed|constraint check failed|no EAP key found|authentication of .* failed|EAP_FAILURE|N\(AUTH_FAILED\)|received AUTHENTICATION_FAILED/) {
            fail = 1
        }

        if (fail) {
            if (ip != "") {
                failed[id] = 1
                print ip
                printf "%s|%s|-|auth_fail|%s\n", now, connname(cn), ip >> ev
            }
        } else if ($0 ~ /IKE_SA .* established/) {
            if (ip != "" && !(id in est)) { est[id] = 1; printf "%s|%s|-|established|%s\n", now, connname(cn), ip >> ev }
        } else if ($0 ~ /IKE_SA .* deleted/) {
            if (ip != "") printf "%s|%s|-|disconnected|%s\n", now, connname(cn), ip >> ev
            # SA gone - stop tracking so the map stays bounded, and let the
            # next attempt from this address be counted on its own
            delete addr[id]
            delete failed[id]
        }
    }
    END {
        printf "" > astateout          # always (re)create, even if map is empty
        for (k in addr) print k "\t" addr[k] "\t" ((k in failed) ? "1" : "0") >> astateout
        close(astateout)
    }'
    # commit the refreshed id->ip map
    if [ -f "$ADDR_TMP" ]; then
        # safety cap so a flood of never-deleted SAs cannot grow it unbounded
        LN=$(wc -l < "$ADDR_TMP" 2>/dev/null); [ -n "$LN" ] || LN=0
        if [ "$LN" -gt "$ADDR_MAX_LINES" ]; then
            tail -n "$ADDR_MAX_LINES" "$ADDR_TMP" > "${ADDR_TMP}.2" && mv "${ADDR_TMP}.2" "$ADDR_TMP"
        fi
        mv "$ADDR_TMP" "$ADDR_STATE"
    fi

    # cap events.log so it cannot grow without bound
    if [ -f "$EVENTS_LOG" ]; then
        LN=$(wc -l < "$EVENTS_LOG" 2>/dev/null); [ -n "$LN" ] || LN=0
        if [ "$LN" -gt "$EVENTS_MAX_LINES" ]; then
            tail -n "$EVENTS_MAX_LINES" "$EVENTS_LOG" > "${EVENTS_LOG}.tmp" \
                && mv "${EVENTS_LOG}.tmp" "$EVENTS_LOG"
        fi
    fi
}

# kept as a thin wrapper: existing callers just want the failure IP stream
scan_failures() { scan_ike_log; }

record_failures() {
    # scan_ike_log() always runs (writes events.log for the UI's Log page);
    # only register with DSM auto-block when the package setting is on.
    NOW=$(date +%s)
    NEW=$(scan_failures)
    [ "$IKEV2_AUTOBLOCK" = "yes" ] && [ "$AB_ENABLE" != "no" ] || return 0
    [ -n "$NEW" ] || { prune_faildb; return 0; }

    touch "$FAILDB"
    for ip in $NEW; do
        echo "$NOW $ip" >> "$FAILDB"
    done
    prune_faildb

    # block offenders that reached DSM's threshold
    for ip in $(printf '%s\n' "$NEW" | sort -u); do
        CNT=$(grep -c " ${ip}\$" "$FAILDB" 2>/dev/null)
        [ "$CNT" -ge "$AB_ATTEMPTS" ] 2>/dev/null || continue
        if is_allowed "$ip"; then
            log "threshold reached but $ip is in DSM allow list - skipped"
            continue
        fi
        if db_block "$ip"; then
            log "auto-blocked $ip (${CNT} failed attempts within ${AB_WITHIN_SEC}s, DSM threshold ${AB_ATTEMPTS})"
            sed -i "/ ${ip}\$/d" "$FAILDB" 2>/dev/null
        fi
    done
}

prune_faildb() {
    [ -f "$FAILDB" ] || return 0
    NOW=$(date +%s)
    LIMIT=$((NOW - AB_WITHIN_SEC))
    awk -v l="$LIMIT" '$1 >= l' "$FAILDB" > "${FAILDB}.tmp" 2>/dev/null \
        && mv "${FAILDB}.tmp" "$FAILDB"
}

# ---------------------------------------------------------------- lifecycle

is_running() {
    P=$(cat "$PIDFILE" 2>/dev/null)
    [ -n "$P" ] && kill -0 "$P" 2>/dev/null
}

do_run() {
    echo $$ > "$PIDFILE"
    log "watcher started (pid $$)"
    T=0
    while :; do
        # refresh DSM + package settings every ~5 min
        if [ "$T" -le 0 ]; then
            read_ab_settings
            read_pkg_settings
            # Puts the notification tag back if DSM rebuilt its text cache -
            # a stat and one query while it is still there.
            notify_ensure || true
            # Whether a newer release exists, and the notice if there is one.
            # This is what makes the notice arrive without the management page
            # ever being opened. Both the lookup and the notice have their own
            # intervals, so this tick only reads a clock most of the time.
            release_announce || true
            T=300
        fi
        # always runs: writes events.log for the UI's Log page, and (only
        # when IKEV2_AUTOBLOCK=yes and DSM auto-block is enabled) registers
        # offenders in DSM's auto-block DB
        record_failures
        sync_block_rules
        sleep "$INTERVAL"
        T=$((T - INTERVAL))
    done
}

do_start() {
    is_running && return 0
    mkdir -p "$VAR"
    nohup "$0" run >/dev/null 2>&1 &
    log "watcher launching"
}

do_stop() {
    P=$(cat "$PIDFILE" 2>/dev/null)
    if [ -n "$P" ]; then
        kill "$P" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    block_remove
    log "watcher stopped"
}

do_status() {
    if is_running; then echo "watcher=yes"; else echo "watcher=no"; fi
    [ -f "$AB_DB" ] && echo "autoblock_db=yes" || echo "autoblock_db=no"
    read_ab_settings
    echo "dsm_autoblock=${AB_ENABLE}"
    N=$(denied_ips | wc -l | tr -d ' ')
    echo "blocked_count=${N}"
}

do_events() {
    [ -f "$EVENTS_LOG" ] || return 0
    tail -n "${1:-200}" "$EVENTS_LOG"
}

do_events_clear() {
    : > "$EVENTS_LOG" 2>/dev/null
    log "event log cleared"
}

case "$1" in
    start)        do_start ;;
    stop)         do_stop ;;
    run)          do_run ;;
    status)       do_status ;;
    events)       do_events "$2" ;;
    events-clear) do_events_clear ;;
    *)
        echo "usage: $0 start|stop|run|status|events|events-clear" >&2
        exit 1
        ;;
esac
