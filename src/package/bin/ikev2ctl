#!/bin/sh
# ikev2ctl - IKEv2 VPN Server control helper
#
# Needs root. On DSM 7.2 the package runs as the package user, so this
# tool is normally invoked through bin/asroot, which uses the sudo rule
# installed by 'ikev2-setup install'.
#
# Runs its OWN bundled strongSwan charon daemon (target/strongswan/) and
# controls it via swanctl/vici - it does NOT depend on, or inject into,
# Synology VPN Server (VPNCenter). VPNCenter's own L2TP/IPSec, if enabled,
# also wants UDP 500/4500 - only one of the two can own those ports at a
# time (see README).
#
# Supported auth methods (run simultaneously, each its own swanctl conn):
#   - ikev2        : EAP-MSCHAPv2 (package accounts, or DSM accounts via
#                    their NT hashes read from synosmbpasswd.conf)
#   - ikev2-psk    : pre-shared key
#   - ikev2-rsa    : client certificate (pubkey), issued by package CA
#   - ikev2-eaptls : EAP-TLS client certificate
#
# The implementation lives in bin/lib/*.sh, one module per area; this file
# only loads them and maps the command line onto them.
#
# usage: ikev2ctl apply|remove|reload|status|clients
#        ikev2ctl disconnect <conn>|log-dump
#        ikev2ctl notify-release <version>
#        ikev2ctl notify-register | notify-unregister
#        ikev2ctl cert-issue <name> <p12pass> <outfile>
#        ikev2ctl cert-list | cert-del <name>

LIB_DIR="$(dirname "$0")/lib"

# common.sh defines the paths every other module builds on, so it is loaded
# first; the rest are plain function definitions and load in glob order.
. "${LIB_DIR}/common.sh" || exit 1
for _lib in "${LIB_DIR}"/*.sh; do
    case "$_lib" in
        */common.sh) continue ;;
    esac
    [ -f "$_lib" ] && . "$_lib"
done

case "$1" in
    apply)       do_apply ;;
    restart)     do_restart ;;
    remove)      do_remove ;;
    reload)      do_reload ;;
    status)      do_status ;;
    dsm-users)   dsm_users_list ;;
    dsm-certs)   dsm_cert_list ;;
    clients)     do_clients ;;
    disconnect)  disconnect_conn "$2" ;;
    log-dump)    do_log_dump ;;
    notify-release)    do_notify_release "$2" ;;
    notify-register)   notify_register ;;
    notify-unregister) notify_unregister ;;
    cert-issue)  cert_issue "$2" "$3" "$4" ;;
    cert-list)   cert_list ;;
    cert-del)    cert_del "$2" ;;
    *)
        echo "usage: $0 apply|remove|reload|status|dsm-users|clients|disconnect|log-dump|notify-release|notify-register|notify-unregister|cert-issue|cert-list|cert-del" >&2
        exit 1
        ;;
esac
